{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "jsx": "preserve",
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "es2020",
        "allowJs": true,
        "checkJs": false,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*", "next.config.mjs"]
}
