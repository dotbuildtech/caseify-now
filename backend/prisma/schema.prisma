generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id             Int              @id @default(autoincrement())
  name           String           @unique @db.VarChar(80)
  slug           String           @unique @db.VarChar(100)
  logo           String?
  description    String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?        @db.Timestamptz(6)
  DeviceModels   DeviceModel[]

  @@map("Brands")
}

model DeviceModel {
  id           Int                          @id @default(autoincrement())
  name         String                       @db.VarChar(120)
  slug         String                       @unique @db.VarChar(140)
  deviceType   enum_DeviceModels_deviceType @default(phone)
  releaseYear  Int?
  image        String?
  displayOrder Int                          @default(0)
  isActive     Boolean                      @default(true)
  createdAt    DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?                    @db.Timestamptz(6)
  BrandId      Int?
  Brands       Brand?                       @relation(fields: [BrandId], references: [id])

  @@index([BrandId], map: "device_models__brand_id")
  @@index([deviceType], map: "device_models_device_type")
  @@index([slug], map: "device_models_slug")
  @@map("DeviceModels")
}

model CustomDesign {
  id             Int      @id @default(autoincrement())
  name           String    @db.VarChar(200)
  description    String?   @db.Text
  modelSlug      String    @db.VarChar(140)
  image          String    @db.Text
  price          Int       @default(399)
  compareAtPrice Int?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([modelSlug])
  @@index([isActive])
  @@map("CustomDesigns")
}

enum enum_DeviceModels_deviceType {
  phone
  smartwatch
  laptop
  tablet
  earbuds
}
