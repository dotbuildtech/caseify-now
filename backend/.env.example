PORT=5001
# Comma-separated, exact protocol://host values (no trailing slash).
# REQUIRED in production; e.g. https://dotbuild-project.vercel.app
CORS_ORIGIN=http://localhost:3000
# Set to "true" only if CORS_ORIGIN should contain "*" (state-changing requests still blocked unless true)
CORS_ALLOW_WILDCARD=false
DATABASE_URL=postgres://user:password@localhost:5432/phone_cover_platform
JWT_SECRET=your_jwt_secret_here
OTP_EXPIRY=5
NODE_ENV=development
# Order pricing (keep in sync with the frontend checkout display)
# TAX_RATE: GST fraction applied to items subtotal (0.18 = 18%)
# SHIPPING_FEE: flat shipping charge; FREE_SHIPPING_THRESHOLD: orders at/above this subtotal ship free
TAX_RATE=0.18
SHIPPING_FEE=49
FREE_SHIPPING_THRESHOLD=500
# How long an initiated-but-unpaid payment session may hold a stock reservation
# before it is released and the session is marked Expired (default 60 minutes)
INITIATION_EXPIRY_MINUTES=60
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_PROJECT_ID=your_aisensy_project_id_here
# PayU Payment Gateway
# PAYU_MODE: "test" (https://test.payu.in/_payment) or "production" (https://secure.payu.in/_payment)
# PAYU_SUCCESS_URL / PAYU_FAILURE_URL: public HTTPS pages PayU redirects the customer to.
#   They must be HTTPS and whitelisted in your PayU dashboard (the ?orderId=... param is appended automatically).
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_salt
PAYU_MODE=test
PAYU_SUCCESS_URL=http://localhost:3000/payment/success
PAYU_FAILURE_URL=http://localhost:3000/payment/failure

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Caseify Now <your-email@gmail.com>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=