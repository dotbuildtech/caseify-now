PORT=5001
# Comma-separated, exact protocol://host values (no trailing slash).
# REQUIRED in production; e.g. https://dotbuild-project.vercel.app
CORS_ORIGIN=http://localhost:3000
# Set to "true" only if CORS_ORIGIN should contain "*" (state-changing requests still blocked unless true)
CORS_ALLOW_WILDCARD=false
DATABASE_URL=postgres://user:password@localhost:5432/phone_cover_platform
JWT_SECRET=your_jwt_secret_here
OTP_EXPIRY=5
NODE_ENV=development
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_PROJECT_ID=your_aisensy_project_id_here
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=test_secret_xxxxxxxxxxxxxxxxxxxx

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Caseify Now <your-email@gmail.com>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=