PORT=5001
NODE_ENV=development

# Database
DATABASE_URL=postgres://user:password@localhost:5432/phone_cover_platform

# Auth
JWT_SECRET=replace-with-strong-random-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OTP
OTP_EXPIRY=5

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# CORS_ALLOW_WILDCARD=true

# Rate limiting
TRUST_PROXY=1

# Cart
CART_MAX_QTY_PER_ITEM=99
CART_MAX_DISTINCT_ITEMS=50
CART_IDLE_DAYS=30
